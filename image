<!DOCTYPE html>
<html>
<head><title>Image Method</title></head>
<body>
  <h2>Image Method</h2>
  <input type="file" id="file" accept="image/*"><br><br>
  <div id="gallery"></div>

  <script>
    let imgs = JSON.parse(localStorage.getItem('imgs') || '[]');
    show();

    document.getElementById('file').onchange = e => {
      const file = e.target.files[0];
      const reader = new FileReader();
      reader.onload = ev => {
        imgs.push(ev.target.result);
        localStorage.setItem('imgs', JSON.stringify(imgs));
        show();
      };
      reader.readAsDataURL(file);
    };

    function show() {
      const div = document.getElementById('gallery');
      div.innerHTML = '';
      imgs.forEach(src => {
        const img = new Image();
        img.src = src;
        img.style.maxWidth = '200px';
        div.appendChild(img);
      });
    }
  </script>
</body>
</html>
